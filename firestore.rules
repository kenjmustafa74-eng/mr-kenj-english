rules_version = '2';
// One global level-access document for every student.
// A write is allowed only for tchmk9@gmail.com after Firebase has marked
// that address verified. An unverified, anonymous, or different account
// cannot write. updatedBy must be that same verified address. Delete is
// refused. These rules are not deployed from this repository.
// This file is written for a Firebase project used by this app. The last
// match denies every other path. If the project already stores other data,
// merge this match into those rules instead of replacing them blindly.
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'tchmk9@gmail.com'
        ];
    }

    function validLevelAccess() {
      return request.resource.data.keys().hasOnly(['locks', 'updatedAt', 'updatedBy'])
        && request.resource.data.locks is map
        && request.resource.data.locks.keys().hasOnly(['A', 'B', 'C'])
        && request.resource.data.locks.A is bool
        && request.resource.data.locks.B is bool
        && request.resource.data.locks.C is bool
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedBy == request.auth.token.email.lower();
    }

    function isSignedInVerified() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return isSignedInVerified() && request.auth.uid == uid;
    }

    match /settings/levelAccess {
      allow read: if true;
      allow create, update: if isTeacher() && validLevelAccess();
      allow delete: if false;
    }

    match /accessRequests/{uid} {
      allow get: if isTeacher() || isSelf(uid);
      allow list: if isTeacher();
      allow create: if isSelf(uid)
        && !exists(/databases/$(database)/documents/accessRequests/$(uid))
        && request.resource.data.keys().hasOnly(['email', 'requestedAt'])
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.requestedAt is number;
      allow update, delete: if false;
    }

    match /accessGrants/{uid} {
      allow get: if isTeacher() || isSelf(uid);
      allow list: if isTeacher();
      allow create, update: if isTeacher()
        && request.resource.data.keys().hasOnly(['status', 'updatedAt', 'updatedBy'])
        && (request.resource.data.status == 'approved' || request.resource.data.status == 'revoked')
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedBy == request.auth.token.email.lower();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
